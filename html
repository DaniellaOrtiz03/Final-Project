<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scrapbook Digital - Crea tus recuerdos</title>
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="logo">
                <i class="fas fa-book-heart"></i>
                <span>Scrapbook Digital</span>
            </div>
            <nav class="nav">
                <ul class="nav-list">
                    <li><a href="#inicio" class="nav-link active">Inicio</a></li>
                    <li><a href="#crear" class="nav-link">Crear Scrapbook</a></li>
                    <li><a href="#galeria" class="nav-link">Galería</a></li>
                    <li><a href="#tienda" class="nav-link">Tienda</a></li>
                    <li><a href="#contacto" class="nav-link">Contacto</a></li>
                </ul>
            </nav>
            <div class="user-actions">
                <button class="btn-secondary">
                    <i class="fas fa-user"></i>
                    Iniciar Sesión
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main">
        <!-- Hero Section -->
        <section id="inicio" class="hero">
            <div class="hero-content">
                <h1 class="hero-title">Crea tu Scrapbook Digital</h1>
                <p class="hero-subtitle">Diseña, personaliza y comparte tus recuerdos más preciados</p>
                <button class="btn-primary" onclick="showScrapbookEditor()">
                    <i class="fas fa-plus"></i>
                    Comenzar a Crear
                </button>
            </div>
            <div class="hero-image">
                <div class="floating-elements">
                    <div class="floating-element element-1">📸</div>
                    <div class="floating-element element-2">🎨</div>
                    <div class="floating-element element-3">💝</div>
                    <div class="floating-element element-4">✨</div>
                </div>
            </div>
        </section>

        <!-- Scrapbook Editor -->
        <section id="crear" class="scrapbook-editor" style="display: none;">
            <div class="editor-container">
                <!-- Toolbar -->
                <div class="toolbar">
                    <div class="toolbar-section">
                        <h3>Elementos</h3>
                        <div class="tool-group">
                            <button class="tool-btn" data-tool="photo">
                                <i class="fas fa-image"></i>
                                <span>Foto</span>
                            </button>
                            <button class="tool-btn" data-tool="text">
                                <i class="fas fa-font"></i>
                                <span>Texto</span>
                            </button>
                            <button class="tool-btn" data-tool="sticker">
                                <i class="fas fa-star"></i>
                                <span>Sticker</span>
                            </button>
                        </div>
                    </div>

                    <div class="toolbar-section">
                        <h3>Decoración</h3>
                        <div class="tool-group">
                            <button class="tool-btn" data-tool="frame">
                                <i class="fas fa-square"></i>
                                <span>Marco</span>
                            </button>
                            <button class="tool-btn" data-tool="background">
                                <i class="fas fa-palette"></i>
                                <span>Fondo</span>
                            </button>
                        </div>
                    </div>

                    <div class="toolbar-section">
                        <h3>Acciones</h3>
                        <div class="tool-group">
                            <button class="tool-btn" onclick="saveScrapbook()">
                                <i class="fas fa-save"></i>
                                <span>Guardar</span>
                            </button>
                            <button class="tool-btn" onclick="downloadScrapbook()">
                                <i class="fas fa-download"></i>
                                <span>Descargar</span>
                            </button>
                            <button class="tool-btn" onclick="shareScrapbook()">
                                <i class="fas fa-share"></i>
                                <span>Compartir</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Scrapbook Canvas -->
                <div class="scrapbook-container">
                    <div class="scrapbook-book" id="scrapbookBook">
                        <div class="book-spine"></div>
                        <div class="book-page active-page" id="currentPage">
                            <div class="page-content" id="pageContent">
                                <!-- Los elementos del scrapbook se añadirán aquí -->
                            </div>
                        </div>
                    </div>
                    
                    <!-- Page Navigation -->
                    <div class="page-navigation">
                        <button class="nav-btn" onclick="previousPage()">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <span class="page-counter">
                            <span id="currentPageNum">1</span> / <span id="totalPages">1</span>
                        </span>
                        <button class="nav-btn" onclick="nextPage()">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                        <button class="nav-btn add-page" onclick="addNewPage()">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Gallery Section -->
        <section id="galeria" class="gallery" style="display: none;">
            <div class="container">
                <h2>Galería de Scrapbooks</h2>
                <div class="gallery-grid" id="galleryGrid">
                    <!-- Los scrapbooks guardados se mostrarán aquí -->
                </div>
            </div>
        </section>

        <!-- Store Section -->
        <section id="tienda" class="store" style="display: none;">
            <div class="container">
                <h2>Tienda Premium</h2>
                <div class="store-items">
                    <div class="store-item">
                        <div class="item-preview">
                            <i class="fas fa-star"></i>
                        </div>
                        <h3>Stickers Premium</h3>
                        <p>Colección exclusiva de stickers animados</p>
                        <button class="btn-premium">$2.99</button>
                    </div>
                    <div class="store-item">
                        <div class="item-preview">
                            <i class="fas fa-palette"></i>
                        </div>
                        <h3>Fondos Exclusivos</h3>
                        <p>Fondos temáticos únicos para tus páginas</p>
                        <button class="btn-premium">$1.99</button>
                    </div>
                    <div class="store-item">
                        <div class="item-preview">
                            <i class="fas fa-crown"></i>
                        </div>
                        <h3>Plantillas Pro</h3>
                        <p>Plantillas profesionales diseñadas</p>
                        <button class="btn-premium">$4.99</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contacto" class="contact" style="display: none;">
            <div class="container">
                <h2>Contacto</h2>
                <div class="contact-content">
                    <div class="contact-info">
                        <h3>¿Necesitas ayuda?</h3>
                        <p>Estamos aquí para ayudarte a crear los mejores scrapbooks digitales.</p>
                        <div class="contact-methods">
                            <div class="contact-method">
                                <i class="fas fa-envelope"></i>
                                <span>contacto@scrapbookdigital.com</span>
                            </div>
                            <div class="contact-method">
                                <i class="fas fa-phone"></i>
                                <span>+1 (555) 123-4567</span>
                            </div>
                        </div>
                    </div>
                    <form class="contact-form">
                        <input type="text" placeholder="Tu nombre" required>
                        <input type="email" placeholder="Tu email" required>
                        <textarea placeholder="Tu mensaje" rows="5" required></textarea>
                        <button type="submit" class="btn-primary">Enviar Mensaje</button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <!-- Modals -->
    <div id="photoModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h3>Añadir Foto</h3>
            <input type="file" id="photoInput" accept="image/*">
            <div class="photo-preview" id="photoPreview"></div>
            <button class="btn-primary" onclick="addPhotoToPage()">Añadir a la Página</button>
        </div>
    </div>

    <div id="textModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h3>Añadir Texto</h3>
            <textarea id="textInput" placeholder="Escribe tu texto aquí..."></textarea>
            <div class="text-options">
                <label>Color:
                    <input type="color" id="textColor" value="#333333">
                </label>
                <label>Tamaño:
                    <input type="range" id="textSize" min="12" max="48" value="16">
                </label>
            </div>
            <button class="btn-primary" onclick="addTextToPage()">Añadir a la Página</button>
        </div>
    </div>

    <div id="stickerModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h3>Seleccionar Sticker</h3>
            <div class="sticker-grid">
                <div class="sticker-item" data-sticker="❤️">❤️</div>
                <div class="sticker-item" data-sticker="🌟">🌟</div>
                <div class="sticker-item" data-sticker="🎉">🎉</div>
                <div class="sticker-item" data-sticker="🌸">🌸</div>
                <div class="sticker-item" data-sticker="🎈">🎈</div>
                <div class="sticker-item" data-sticker="🎂">🎂</div>
                <div class="sticker-item" data-sticker="🎁">🎁</div>
                <div class="sticker-item" data-sticker="✨">✨</div>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
